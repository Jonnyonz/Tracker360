# Tracker360 - variables de entorno
# Copiar a .env y completar. install.sh genera un .env con claves aleatorias.
# Nunca subir el .env al repositorio.

# --- Base de datos (obligatorio) ---
POSTGRES_USER=tracker_admin
POSTGRES_PASSWORD=
POSTGRES_DB=tracker360_db
# Servidor y puerto de PostgreSQL vistos desde la API (por defecto el contenedor "db").
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Conexiones maximas del pool. Bajar en equipos con poca RAM.
DB_POOL_MAX=20

# --- Seguridad (obligatorio) ---
# Firma de las sesiones. Generar con: openssl rand -hex 32
SECRET_KEY=
# Token de un solo uso para crear el primer administrador. Generar con: openssl rand -hex 12
SETUP_TOKEN=

# --- Dominio del cliente ---
# Origen(es) del frontend permitidos por CORS, separados por coma.
ALLOWED_ORIGINS=https://wms.suempresa.com

# Proxies inversos de confianza (IPs o redes, separadas por coma). Solo desde ellos se
# aceptan X-Forwarded-For / X-Forwarded-Proto para la IP real y el chequeo de HTTPS.
# Por defecto: loopback y redes de Docker (proxy en el mismo servidor).
TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12

# --- Puertos publicados por Docker ---
# Interfaz y puerto donde se publica la API. Con proxy inverso usar API_BIND=127.0.0.1
API_BIND=0.0.0.0
API_PORT=8001
# Puerto local (solo 127.0.0.1) de PostgreSQL para mantenimiento.
DB_PORT=5433
# Limite de memoria de cada contenedor (ej. 256m, 1g).
API_MEM_LIMIT=384m
DB_MEM_LIMIT=512m

# --- Otros ---
TZ=America/Argentina/Buenos_Aires
# Repositorio de GitHub (usuario/repo) donde el actualizador busca versiones
# y desde donde se descarga el agente de impresion (GitHub Releases).
UPDATER_GITHUB_REPO=Jonnyonz/Tracker360
# Opcional: URL directa del ejecutable del agente. Si se define, tiene prioridad sobre
# la que se arma con UPDATER_GITHUB_REPO. Util si el agente se publica en otro lado.
# AGENT_DOWNLOAD_URL=https://github.com/Jonnyonz/Tracker360/releases/latest/download/Tracker360_Agente.exe

# Anti-SSRF de webhooks: por defecto un webhook no puede apuntar a direcciones internas
# (metadata del cloud, la propia DB, el panel). Poner true solo en instalaciones on-premise
# que necesiten postear a un servicio de la red interna.
WEBHOOK_ALLOW_PRIVATE=false

# --- Agente de impresion (en la PC del cliente, no en el servidor) ---
# Si se define en Windows, el agente la sugiere como URL del servidor al configurarse.
# TRACKER360_SERVER_URL=https://wms.suempresa.com
