# Archivos de entorno y claves secretas
.env
*.env

# Caché de Python
__pycache__/
*.py[cod]
*$py.class

# Datos de la Base de Datos PostgreSQL
postgres_data/
*.sql
# Las migraciones del esquema son codigo, no dumps de la base: se versionan.
!backend/migrations/*.sql

# Logs del sistema
*.log

# Archivos de sistema operativo / IDE
.DS_Store
.vscode/
.idea/
# HTTPS de la instalacion con Docker: lo genera install.sh en cada corrida (Caddyfile y CA local copiada)
caddy/
